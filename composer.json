{
    "name": "nimblephp/storagebox",
    "description": "Universal file storage module for NimblePHP - stores files (local/MinIO/S3) with metadata in the database",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NimblePHP\\Storagebox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NimblePHP\\Storagebox\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Krzysztof Żyłka",
            "email": "krzysztofzylka@yahoo.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nimblephp/framework": ">=0.4.14",
        "nimblephp/migrations": ">=0.3.2",
        "krzysztofzylka/database-manager": ">=1.1.22",
        "aws/aws-sdk-php": "^3.0",
        "nimblephp/crypto": "^0.0.1",
        "krzysztofzylka/console": "^1.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}
